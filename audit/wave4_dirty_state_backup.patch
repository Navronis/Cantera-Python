+class TestWave4FullMatrixStructuralParity:
+    """Rigorous structural tests for full NxN binary and multicomponent diffusion matrices."""
+
+    def test_full_matrix_dimensions_and_properties(self):
+        for mech_path in [GRI30_PATH, H2O2_PATH]:
+            soln = ct.Solution(mech_path)
+            soln.transport_model = 'multicomponent'
+            nsp = soln.n_species
+            tr = soln.transport
+
+            soln.TPX = 1200.0, 202650.0, {soln.species_names[0]: 0.3, soln.species_names[1]: 0.7}
+            tr.updateThermal_T()
+
+            # 1. Dimensions
+            bdiff = tr.binary_diff_coeffs
+            dmulti = tr.multi_diff_coeffs
+            assert bdiff.shape == (nsp, nsp)
+            assert dmulti.shape == (nsp, nsp)
+
+            # 2. Row and column indexing aligns with Solution.species_names ordering
+            assert len(soln.species_names) == nsp
+            for i, name in enumerate(soln.species_names):
+                assert soln.species_index(name) == i
+
+            # 3. Symmetry of binary diffusion matrix
+            assert np.max(np.abs(bdiff - bdiff.T)) < 1e-14
+
+            # 4. Diagonal of binary diffusion matrix matches self-diffusion formula
+            R_gas = ct.GasConstant
+            T = soln.T
+            P = soln.P
+            sp_visc = tr.species_viscosities()
+            for i in range(nsp):
+                mw_i = soln.molecular_weights[i]
+                astar_ii = tr._astar[i, i]
+                expected_dii = 1.2 * R_gas * T * sp_visc[i] * astar_ii / (mw_i * P)
+                assert abs(bdiff[i, i] - expected_dii) / expected_dii < 1e-10
+
+            # 5. Diagonal of multicomponent diffusion matrix is identically zero
+            assert np.all(dmulti.diagonal() == 0.0)
+            assert np.max(np.abs(np.diag(dmulti))) == 0.0
+
