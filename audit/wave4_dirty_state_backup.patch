+def polyfit_cpp(deg: int, x: np.ndarray, y: np.ndarray, w: np.ndarray | None = None) -> np.ndarray:
+    """Exact reproduction of Cantera's polyfit (weighted least squares in increasing powers)."""
+    A = np.vander(x, deg + 1, increasing=True)
